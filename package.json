{
  "name": "root",
  "version": "0.0.0",
  "workspaces": [
    "docs",
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "------------------------------------------------------------------------------": "",
    "build": "turbo run build",
    "-------------------------------------------------------------------------------": "",
    "typecheck": "turbo run typecheck",
    "--------------------------------------------------------------------------------": "",
    "lint": "eslint --cache .",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write . --cache --plugin-search-dir=.",
    "---------------------------------------------------------------------------------": "",
    "test": "turbo run test",
    "aggregate": "node ./scripts/aggregate.mjs",
    "coverage:gen": "pnpm dlx nyc report --reporter html -t .nyc_output --report-dir coverage",
    "coverage:view": "pnpm coverage:gen --reporter text",
    "----------------------------------------------------------------------------------": "",
    "prepare": "husky install",
    "-----------------------------------------------------------------------------------": "",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm run build && changeset publish",
    "version": "changeset version && pnpm install --no-frozen-lockfile && pnpm run format"
  },
  "devDependencies": {
    "@antfu/eslint-config": "0.39.3",
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.26.1",
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "eslint": "8.41.0",
    "eslint-plugin-astro": "^0.27.0",
    "husky": "^8.0.3",
    "nano-staged": "^0.8.0",
    "prettier": "^2.8.8",
    "prettier-plugin-astro": "0.9.0",
    "turbo": "1.9.9"
  },
  "nano-staged": {
    "*.{html,css,ts,js,astro,json,md,yml,yaml}": [
      "pnpm run format",
      "pnpm run lint:fix"
    ]
  }
}
