{
  "printWidth": 80,
  "semi": true,
  "useTabs": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "pluginSearchDirs": ["."],
  "plugins": ["./node_modules/prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ]
}
