---
import type { MarkdownInstance } from "astro";
import type { Page } from "../config";
import BaseLayout from "./BaseLayout.astro";
import DocsLayout from "./DocsLayout.astro";
import PageLayout from "./PageLayout.astro";
import type { PulsarCollectionEntry } from ".";

export interface Props {
  page: PulsarCollectionEntry<Page>;
}

const { page } = Astro.props;
const { Content, headings } = await page.render();

const config = page.data;
const isDocs = config.type === "docs";
const pageTitle = config.title ?? headings[0]?.text ?? "Untitled";

// TODO: Get these from page config
const showNavbar = false;
const showFooter = false;

const content = await Astro.glob<MarkdownInstance<Page>>(
  "../../../../**/src/content/**/*.{md,mdx}"
);
---

<BaseLayout pageTitle={pageTitle}>
  {
    showNavbar && (
      <nav>
        <slot name="navbar" />
      </nav>
    )
  }
  {
    isDocs ? (
      <DocsLayout pages={content}>
        <Content />
        <slot />
      </DocsLayout>
    ) : (
      <PageLayout>
        <Content />
        <slot />
      </PageLayout>
    )
  }

  {
    showFooter && (
      <footer>
        <slot name="footer" />
      </footer>
    )
  }
</BaseLayout>
