---
import type { MarkdownInstance } from "astro";
import Breadcrumbs from "../components/Breadcrumbs/Breadcrumbs.astro";
import LeftSidebar from "../components/LeftSidebar/LeftSidebar.astro";
import { buildSections } from "../components/LeftSidebar/sidebar";
import type { Props as RightSidebarProps } from "../components/RightSidebar/RightSidebar.astro";
import RightSidebar from "../components/RightSidebar/RightSidebar.astro";
import Show from "../components/ui/Show.astro";
import type { Page } from "../config";
import Pagination from "../components/Pagination/Pagination.astro";
import type { Props as PaginationProps } from "../components/Pagination/Pagination.astro";

export interface Props extends RightSidebarProps {
  pages: MarkdownInstance<Page>[];
  showBreadcrumbs: boolean;
  showSidebar: boolean;
  pagination: Omit<PaginationProps, "sidebar">;
}

const { pages, headings, editUrl, showBreadcrumbs, showSidebar, pagination } =
  Astro.props;

const sections = buildSections(pages);
const paginate = pagination.next || pagination.prev;
// TODO: Show last updated date
---

<div class="docs-page">
  <Show when={showSidebar}>
    <aside class="left-sidebar">
      <LeftSidebar sections={sections} />
      <slot name="sidebar-bottom" />
    </aside>
  </Show>

  <article class="wrapper">
    <main class="page-content">
      <Show when={showBreadcrumbs}>
        <Breadcrumbs sidebar={sections} />
      </Show>

      <slot />

      <Show when={paginate}>
        <Pagination
          next={pagination.next}
          prev={pagination.prev}
          sidebar={sections}
        />
      </Show>
    </main>

    <aside class="right-sidebar">
      <RightSidebar headings={headings} editUrl={editUrl} />
    </aside>
  </article>
</div>

<style>
  .docs-page,
  .left-sidebar,
  .wrapper,
  .right-sidebar {
    display: flex;
  }

  .docs-page {
    height: 100%;
    position: relative;
  }

  .left-sidebar {
    position: sticky;
    top: 4rem;
    flex-direction: column;
    width: 16rem;
    border-right: 1px solid #eaeaea;
    padding-top: 0.5rem;
  }

  .wrapper {
    flex: 1;
    padding-top: 1rem;
  }

  .page-content {
    flex: 1;
    padding-left: 3rem;
    padding-right: 3rem;
    max-width: 72rem;
    min-width: 0;
    padding-bottom: 2rem;
    height: fit-content;
  }

  .right-sidebar {
    width: 250px;
    min-width: 256px;
    padding-left: 1rem;
    padding-right: 1rem;
  }
</style>
