---
import LeftSidebar from "../components/LeftSidebar/LeftSidebar.astro";
import type { Props as LeftSidebarProps } from "../components/LeftSidebar/LeftSidebar.astro";

export interface Props extends LeftSidebarProps {}

const { pages } = Astro.props;
---

<div class="docs-page">
  <aside>
    <LeftSidebar pages={pages} />
  </aside>
  <main>
    <slot />
  </main>
</div>

<style>
  .docs-page {
    display: flex;
    height: 100%;
  }

  aside {
    display: flex;
    flex-direction: column;
    width: 300px;
    min-width: 300px;
    border-right: 1px solid #eaeaea;
  }

  main {
    flex: 1;
    padding: 0 20px;
  }
</style>
