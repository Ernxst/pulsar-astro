---
import RightSidebar from "../components/RightSidebar/RightSidebar.astro";
import LeftSidebar from "../components/LeftSidebar/LeftSidebar.astro";
import type { Props as LeftSidebarProps } from "../components/LeftSidebar/LeftSidebar.astro";
import type { Props as RightSidebarProps } from "../components/RightSidebar/RightSidebar.astro";

export interface Props extends LeftSidebarProps, RightSidebarProps {}

const { pages, headings, editUrl } = Astro.props;
---

<div class="docs-page">
  <aside class="left-sidebar">
    <LeftSidebar pages={pages} />
    <slot name="sidebar-bottom" />
  </aside>
  <main>
    <div class="page-content">
      <slot />
    </div>
    <aside class="right-sidebar">
      <RightSidebar headings={headings} editUrl={editUrl} />
    </aside>
  </main>
</div>

<style>
  .docs-page,
  .left-sidebar,
  main,
  .right-sidebar {
    display: flex;
  }

  .docs-page {
    height: 100%;
  }

  .left-sidebar {
    flex-direction: column;
    width: 300px;
    min-width: 300px;
    border-right: 1px solid #eaeaea;
  }

  main {
    flex: 1;
    padding: 2rem;
  }

  .page-content {
    flex: 1;
  }

  .right-sidebar {
    width: 224px;
    min-width: 224px;
    margin-left: 32px;
    overflow-x: hidden;
    overflow-y: auto;
  }
</style>
