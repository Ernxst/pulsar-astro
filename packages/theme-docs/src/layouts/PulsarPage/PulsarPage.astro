---
import { getCollection } from "astro:content";
import Navbar from "../../components/Navbar/Navbar.astro";
import Show from "../../components/ui/Show.astro";
import type { Page } from "../../config";
import { useConfigHandler, usePulsarConfig } from "../../config/app/lib";
import BaseLayout from "../BaseLayout.astro";
import DocsLayout from "../DocsLayout.astro";
import type { Props as DocsLayoutProps } from "../DocsLayout.astro";
import PageLayout from "../PageLayout.astro";
import type { Props as PageLayoutProps } from "../PageLayout.astro";
import type { PulsarCollectionEntry } from "..";
import { getLangFromPathname } from "../../lib/util";
import { collectionToMarkdownFiles, useEditUrl, usePagination } from "./lib";
import ThemeProvider from "./ThemeProvider.astro";
import LastUpdatedProvider from "./LastUpdatedProvider.astro";

export interface Props {
  page: PulsarCollectionEntry<Page>;
}

const { page } = Astro.props;
const { Content, headings } = await page.render();

const { navbar, footer, breadcrumbs, ...pageConfig } = page.data;
const siteConfig = await usePulsarConfig();

const pageTitle = pageConfig.title ?? headings[0]?.text ?? "Untitled";

const pathname = Astro.url.pathname;
const defaultLocale = siteConfig.site.defaultLocale;
const lang = getLangFromPathname(pathname) ?? defaultLocale;

const { siteTitle, dir } = siteConfig.site;
const seo = siteConfig.seo ?? {};

const handler = useConfigHandler(siteConfig);
const formattedTitle = await handler.title({ pathname, title: pageTitle });
const formattedDescription = await handler.description({
  pathname,
  title: pageTitle,
});

let config:
  | { Layout: typeof DocsLayout; layoutProps: DocsLayoutProps }
  | { Layout: typeof PageLayout; layoutProps: PageLayoutProps };

if (pageConfig.type === "docs") {
  const pages = await collectionToMarkdownFiles(page.collection, getCollection);

  config = {
    Layout: DocsLayout,
    layoutProps: {
      pages,
      headings,
      showBreadcrumbs: breadcrumbs,
      showSidebar: pageConfig.sidebar,
      editUrl: useEditUrl({
        siteConfig,
        pageCollection: {
          collection: page.collection,
          id: page.id,
          data: pageConfig,
        },
      }),
      pagination: usePagination({ siteConfig, pageConfig }),
      collection: page.collection,
    },
  };
} else {
  config = { Layout: PageLayout, layoutProps: {} };
}
---

<BaseLayout
  siteTitle={siteTitle}
  pageTitle={formattedTitle}
  description={formattedDescription}
  lang={lang}
  dir={dir}
  seo={seo}
>
  <Show when={navbar}>
    <div class="navbar-container">
      <Navbar>
        <slot name="navbar" />
      </Navbar>
    </div>
  </Show>

  <config.Layout {...config.layoutProps}>
    <Content />
    <slot />
    <LastUpdatedProvider pageCollection={page} siteConfig={siteConfig} />
    <ThemeProvider siteConfig={siteConfig} slot="sidebar-bottom" />
  </config.Layout>

  <Show when={footer}>
    <footer>
      <slot name="footer" />
    </footer>
  </Show>
</BaseLayout>

<style>
  .navbar-container {
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 10;
  }
</style>
