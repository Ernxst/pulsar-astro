---
import { getLangFromPathname } from "../../lib/util";
import type { PulsarCollectionEntry } from "..";
import Show from "../../components/ui/Show.astro";
import Timestamp from "../../components/ui/Timestamp.astro";
import type { Page, PulsarDocsConfig } from "../../config";
import { getLastUpdatedDate } from "../../lib/github";
import { formatUrl } from "./lib";

export interface Props {
  pageCollection: PulsarCollectionEntry<Page>;
  siteConfig: PulsarDocsConfig;
}

const { pageCollection, siteConfig } = Astro.props;
const { collection, id: relativeToProject } = pageCollection;

const filepath = formatUrl(`/src/content/${collection}/${relativeToProject}`);
const lastUpdated = await getLastUpdatedDate(filepath);

const { pathname } = Astro.url;
const locale = getLangFromPathname(pathname) ?? siteConfig.site.defaultLocale;
---

<Show when={lastUpdated}>
  <span class="timestamp">
    <Timestamp timestamp={lastUpdated!} locale={locale} />
  </span>
</Show>

<style>
  .timestamp {
    width: 100%;
    text-align: right;
    margin-top: 4rem;
    margin-bottom: 2rem;
    font-size: 0.75rem;
    display: block;
  }
</style>
