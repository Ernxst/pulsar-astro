---
import type { PulsarCollectionEntry } from "..";
import Show from "../../components/ui/Show.astro";
import Timestamp from "../../components/ui/Timestamp.astro";
import type { Page, PulsarDocsConfig } from "../../config";
import { getLastUpdatedDate } from "./github";
import { formatUrl } from "./lib";

export interface Props {
  pageCollection: PulsarCollectionEntry<Page>;
  siteConfig: PulsarDocsConfig;
}

const { pageCollection, siteConfig } = Astro.props;
const { collection, id: filePath } = pageCollection;

const { url: projectUrl } = siteConfig.repositories.project ?? {};
const { token, url } = siteConfig.repositories.documentation ?? {};
const docsUrl = url ?? projectUrl;

const filepath = formatUrl(`/src/content/${collection}/${filePath}`);

const shouldFetchLastUpdated = token && docsUrl;
const lastUpdated = shouldFetchLastUpdated
  ? await getLastUpdatedDate({ token, repoUrl: docsUrl, file: filepath })
  : undefined;

// TODO: This should be the locale of the page and should fallback to the site default
const locale = siteConfig.site.defaultLocale;
---

<Show when={lastUpdated}>
  <span class="timestamp">
    <Timestamp timestamp={lastUpdated!} locale={locale} />
  </span>
</Show>

<style>
  .timestamp {
    width: 100%;
    text-align: right;
    margin-top: 4rem;
    margin-bottom: 2rem;
    font-size: 0.75rem;
    display: block;
  }
</style>
