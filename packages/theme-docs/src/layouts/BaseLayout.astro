---
import type { PulsarDocsConfig } from "src/config";
import type { Props as HeadCommonProps } from "../components/HeadCommon.astro";
import HeadCommon from "../components/HeadCommon.astro";
import type { Props as HeadSEOProps } from "../components/HeadSEO.astro";
import HeadSEO from "../components/HeadSEO.astro";

import "../styles/global.css";

export interface Props {
  dir: "ltr" | "rtl";
  siteTitle: string;
  pageTitle: string;
  description: string;
  lang: string;
  seo: PulsarDocsConfig["seo"];
}

const { pageTitle, siteTitle, description, lang, seo, dir } = Astro.props;

const headCommonProps: HeadCommonProps = {};

const headSeoProps: HeadSEOProps = {
  site: { title: siteTitle, lang },
  page: { title: pageTitle, description },
  og: seo.openGraph,
  twitter: seo.twitter,
  canonicalUrl: Astro.url.toString(),
};
---

<html lang={lang} dir={dir}>
  <head>
    <HeadCommon {...headCommonProps} />
    <title>{pageTitle}</title>
    <HeadSEO {...headSeoProps} />
  </head>

  <body data-js="false" onload="document.body.setAttribute('data-js', '')">
    <slot />
  </body>
</html>
