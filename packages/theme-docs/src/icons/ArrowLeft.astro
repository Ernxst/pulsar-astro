---
export interface Props {
  width?: number;
  height?: number;
}

const { width = 12, height = 12 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="lucide lucide-arrow-left"
  ><line x1="19" x2="5" y1="12" y2="12"></line><polyline
    points="12 19 5 12 12 5"></polyline></svg
>
