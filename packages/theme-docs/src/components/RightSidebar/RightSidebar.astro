---
import type { MarkdownHeading } from "astro";
import Show from "../ui/Show.astro";
import Edit from "../../icons/Edit.astro";
import RightSidebarNav from "./RightSidebarNav.astro";

export interface Props {
  headings: MarkdownHeading[];
  editUrl?: string;
}

const { headings: allHeadings, editUrl } = Astro.props;
const headings = allHeadings.filter((heading) => heading.depth > 1);
const hasHeadings = headings.length > 0;
---

<div class="page-navigation">
  <Show when={hasHeadings}>
    <h2 class="right-sidebar-header">On this page</h2>
    <RightSidebarNav headings={headings} />
  </Show>

  <div
    class:list={{
      container: true,
      "has-headings": hasHeadings,
    }}
  >
    <Show when={editUrl}>
      <a
        href={editUrl}
        rel="noopener noreferrer"
        target="_blank"
        class="edit-link"
      >
        <Edit />
        Edit this page on GitHub
      </a>
    </Show>
  </div>
</div>

<style>
  .page-navigation {
    width: 100%;
  }

  .right-sidebar-header {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 1rem;
    padding-left: 1rem;
  }

  .container.has-headings {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    /* TODO: Shadow colour can be a variable */
    box-shadow: rgba(0, 0, 0, 0) 0px 0px 0px 0px,
      rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgb(255, 255, 255) 0px -12px 16px 0px;
  }

  :global(.dark .page-navigation > .container.has-headings) {
    box-shadow: rgba(0, 0, 0, 0) 0px 0px 0px 0px,
      rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgb(17, 17, 17) 0px -12px 16px 0px;
  }

  .edit-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 12px;
  }

  .edit-link svg {
    margin-top: -1.5px;
  }
</style>
