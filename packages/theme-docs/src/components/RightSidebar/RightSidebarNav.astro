---
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<nav class="right-sidebar-nav">
  <ul class="sidebar-links">
    {
      headings.map(({ slug, text, depth }) => (
        <li>
          <a
            class="sidebar-link"
            href={`#${slug}`}
            style={`--depth: ${depth - 1}`}
          >
            {text.trim()}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<script>
  // Ignore the title heading
  const pageHeaders = document.querySelectorAll(
    ".page-content h2, .page-content h3, .page-content h4, .page-content h5, .page-content h6"
  );

  const observer = new IntersectionObserver(
    (entries) => {
      let activeHref = null;
      for (const entry of entries) {
        if (entry.isIntersecting) {
          activeHref = `#${entry.target.id}`;
          break;
        }
      }

      const nav = document.querySelector(".right-sidebar-nav");
      const sidebarLinks = nav.querySelectorAll("a");

      if (activeHref) {
        for (const link of sidebarLinks) {
          const url = new URL(link.href);
          if (url.hash === activeHref) link.classList.add("active");
          else link.classList.remove("active");
        }
      }
    },
    {
      // Negative top margin accounts for `scroll-margin`.
      // Negative bottom margin means heading needs to be towards top of viewport to trigger intersection.
      rootMargin: `-64px 0% -40%`,
      threshold: 1,
    }
  );

  pageHeaders.forEach((header) => {
    observer.observe(header);
  });
</script>

<style>
  .sidebar-links {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-links::before {
    content: "";
    position: absolute;
    left: 0px;
    width: 1px;
    height: 100%;
    background: #e2e8f0;
  }

  .sidebar-links li {
    display: flex;
    align-items: center;
    line-height: 24px;
  }

  .sidebar-link[style*="--depth: 1"] {
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .sidebar-link {
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 14px;
    padding: 0.3rem 0.2rem;
    padding-left: 1rem;
    position: relative;
    padding-left: calc(var(--depth) * 1rem);
  }

  .sidebar-link.active {
    font-weight: 500;
    pointer-events: none;
    color: blue;
  }

  .sidebar-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    margin-top: auto;
    margin-bottom: auto;
    width: 1.5px;
    height: 20px;
    background: blue;
  }
</style>
