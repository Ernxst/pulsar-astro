---
import Select, { type SelectOption } from "./Select.astro";

export interface Props {
  storageKey: string;
  themes: Theme[];
}

export interface Theme extends SelectOption {
  icon: string;
}

const { themes, storageKey } = Astro.props;
const defaultIcon = themes.find((theme) => theme.default)?.icon;
---

<!-- This is intentionally inlined to avoid FOUC -->
<script is:inline define:vars={{ storageKey, themes }}>
  const root = document.documentElement;
  const classNames = themes.map((theme) => theme.className);

  function setTheme(className) {
    localStorage.setItem(storageKey, className);

    root.classList.remove(...classNames);
    if (className === "system") {
      const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (dark) root.classList.add("dark");
      else root.classList.remove("dark");
    } else {
      root.classList.add(className);
    }

    const selectedTheme = themes.find((t) => t.className === className);
    const switcher = document.getElementById("theme-switcher");

    if (switcher) {
      const icon = switcher.querySelector("button > .icon");
      icon.innerHTML = selectedTheme.icon;
    }
  }

  const theme = localStorage.getItem(storageKey);
  setTheme(theme);

  document.addEventListener("DOMContentLoaded", () => {
    const switcher = document.getElementById("theme-switcher");
    // Call it again to set the right icon
    setTheme(theme);

    switcher.addEventListener("change", (event) => {
      setTheme(event.target.value);
    });
  });
</script>

<Select
  id="theme-switcher"
  aria-label="Select a theme"
  options={themes}
  storageKey={storageKey}
>
  <span class="icon" slot="icon" set:html={defaultIcon} />
</Select>

<style>
  .icon {
    width: 12px;
    height: 12px;
    margin-right: 2px;
  }
</style>
