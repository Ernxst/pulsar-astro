---
import { type Sidebar } from "../LeftSidebar/sidebar";
import Show from "../ui/Show.astro";
import ChevronRight from "../../icons/ChevronRight.astro";
import { useBreadcrumbs } from "./useBreadcrumbs";

export interface Props {
  sidebar: Sidebar;
  collectionName: string;
}

const { sidebar, collectionName } = Astro.props;
const crumbs = useBreadcrumbs(Astro.url.pathname, sidebar, collectionName);
---

<nav aria-label="Breadcrumb">
  <ol class="crumbs">
    {
      crumbs.map(({ url, title }, idx) => (
        <li>
          <Show when={idx > 0}>
            <ChevronRight />
          </Show>

          <Show when={url}>
            <a
              class="breadcrumb"
              href={url}
              aria-current={idx === crumbs.length - 1 ? "page" : undefined}
            >
              {title}
            </a>
          </Show>

          <Show when={!url}>
            <span class="breadcrumb">{title}</span>
          </Show>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs,
  .crumbs li {
    display: flex;
    gap: 0.25rem;
  }

  .crumbs li {
    align-items: center;
  }

  .breadcrumb {
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breadcrumb[aria-current="page"] {
    font-weight: 600;
    pointer-events: none;
  }

  span.breadcrumb {
    cursor: default;
  }
</style>
