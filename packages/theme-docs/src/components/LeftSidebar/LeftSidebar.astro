---
import { type Sidebar } from "./sidebar.js";
import SidebarSection from "./SidebarSection.astro";

export interface Props {
  sections: Sidebar;
}

const { sections } = Astro.props;
---

<nav class="sidebar" aria-labelledby="grid-left">
  <ul class="sidebar-groups">
    {
      Object.values(sections).map((child) => {
        const isRootReadonlyParent =
          !child.url && Object.keys(child.children).length > 0;
        const cls = isRootReadonlyParent ? "root-readonly" : "";

        return (
          <li class={cls}>
            <SidebarSection {...child} depth={0} />
          </li>
        );
      })
    }
  </ul>
</nav>

<style is:global>
  /* <!-- Very hacky --> */
  nav.sidebar
    > ul.sidebar-groups
    > li.root-readonly
    > .sidebar-section
    > .accordion-item
    > .toggle {
    margin-top: 1.25rem;
    margin-bottom: 0.66rem;
  }

  nav.sidebar
    > ul.sidebar-groups
    > li:first-child
    > .sidebar-section
    > .accordion-item
    > .toggle {
    margin-top: 0;
  }

  nav.sidebar
    > ul.sidebar-groups
    > li
    .sidebar-section.active-section
    > .accordion-item
    > .toggle {
    background-color: red;
    pointer-events: none;
    font-weight: 600;
  }
</style>

<style>
  .sidebar {
    height: 100%;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 1rem;
    flex: 1;
  }

  .sidebar-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
