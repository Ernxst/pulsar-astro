---
export interface Props {
  title: string;
  url?: string;
  children: Record<string, Omit<Props, "depth">>;
  depth: number;
}

const { title, url, children, depth } = Astro.props;

const Heading = `h${depth + 2}`;
const isCurrent = Astro.url.pathname === url;
const isLink = !!url;
const hasLinkChild = Object.values(children).some((child) => !!child.url);
---

<section
  class="sidebar-section"
  data-active={isCurrent}
  data-depth={depth}
  data-is-link={isLink}
  data-has-link-child={hasLinkChild}
>
  {
    url ? (
      <Heading class="sidebar-section-title sidebar-link">
        <a href={url} aria-current={isCurrent} rel="prefetch">
          {title}
        </a>
      </Heading>
    ) : (
      <Heading class="sidebar-section-title no-link">{title}</Heading>
    )
  }

  <!-- TODO: Accordion to expand and collapse -->
  {
    Object.values(children).length ? (
      <ul class="sidebar-children">
        {Object.values(children).map((child) => (
          <li class="sidebar-child">
            <Astro.self {...child} depth={depth + 1} />
          </li>
        ))}
      </ul>
    ) : (<></>)
  }
</section>

<style define:vars={{ depth }}>
  .sidebar-section {
    margin-left: calc(0.25rem * var(--depth));
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-section:not([data-is-link])[data-depth="1"] {
    margin-left: 0;
  }

  .sidebar-section-title {
    font-size: 14px;
    display: flex;
  }

  [data-active] > .sidebar-section-title > a {
    background: red;
    pointer-events: none;
    font-weight: 600;
  }

  .sidebar-link > a {
    padding: 6px 8px;
    border-radius: 0.33rem;
    width: 100%;
  }

  .sidebar-link > a:hover {
    background: blue;
  }

  .no-link {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    cursor: default;
  }

  [data-depth="0"] > .no-link {
    font-weight: 600;
  }

  [data-depth="1"] > .no-link {
    margin-top: 0;
  }

  .sidebar-children {
    display: grid;
    grid-auto-flow: row;
    gap: 0.5rem;
  }

  [data-depth="0"] > .sidebar-children {
    margin-left: 0;
    border-left: none;
  }

  [data-has-link-child] > .sidebar-children {
    margin-left: 5px;
    border-left: 1px solid gray;
  }
</style>
