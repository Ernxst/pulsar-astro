---
import AccordionItem from "../ui/Accordion/AccordionItem.astro";
import SidebarSectionChildren from "./SidebarSectionChildren.astro";
import SidebarSectionHeading from "./SidebarSectionHeading.astro";

export interface Props {
  title: string;
  url?: string;
  children: Record<string, Omit<Props, "depth">>;
  depth: number;
}

const { title, url, children, depth } = Astro.props;

const active = Astro.url.pathname === url;
const isRoot = depth === 0;
const isIdented = depth > 1;
const isOpen = depth < 2;
const hasChildren = Object.keys(children).length > 0;
const interactive = Boolean(url);

const isRootReadonlyParent = isRoot && !interactive && hasChildren;
const spacing = isRootReadonlyParent ? "sm" : "none";
---

<section
  class:list={[
    {
      "sidebar-section": true,
      indented: isIdented,
      [`spacing-${spacing}`]: true,
    },
  ]}
>
  <AccordionItem
    id={title}
    open={isOpen}
    collapsible={hasChildren}
    interactive={interactive}
  >
    <SidebarSectionHeading
      title={title}
      url={url}
      depth={depth}
      active={active}
      slot="header"
    />

    <SidebarSectionChildren
      children={children}
      depth={depth}
      isRoot={isRoot}
      slot="content"
    />
  </AccordionItem>
</section>

<style define:vars={{ depth }}>
  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-section.indented {
    margin-left: calc(0.25rem * var(--depth));
  }
</style>
