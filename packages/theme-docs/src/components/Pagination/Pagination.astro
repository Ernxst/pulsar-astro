---
import ArrowLeft from "../../icons/ArrowLeft.astro";
import type { Sidebar } from "../LeftSidebar/sidebar";
import Show from "../ui/Show.astro";
import ArrowRight from "../../icons/ArrowRight.astro";
import { usePrevNext } from "./usePrevNext";

export interface Props {
  next: boolean;
  prev: boolean;
  sidebar: Sidebar;
}

const { next, prev, sidebar } = Astro.props;
const pagination = usePrevNext(Astro.url.pathname, sidebar);
const showPrev = prev && pagination && pagination.prev;
const showNext = next && pagination && pagination.next;
---

<nav class="container">
  <ul class="navigation">
    <Show when={showPrev}>
      <li>
        <a
          class="link prev"
          title="Go to the previous page"
          href={pagination?.prev?.url}
        >
          <span class="subtitle">
            <ArrowLeft />
            Previous page</span
          >
          <span class="title">{pagination?.prev?.title}</span>
        </a>
      </li>
    </Show>

    <Show when={showNext}>
      <li class="next">
        <a
          class="link next"
          title="Go to the next page"
          href={pagination?.next?.url}
        >
          <span class="subtitle"
            >Next page
            <ArrowRight />
          </span>
          <span class="title">{pagination?.next?.title}</span>
        </a>
      </li>
    </Show>
  </ul>
</nav>

<style>
  .container {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eaeaea;
  }

  .navigation {
    display: flex;
    gap: 1rem;
  }

  li.next {
    margin-left: auto;
  }

  .link {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
  }

  .link.next {
    align-items: flex-end;
    text-align: right;
  }

  .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25rem;
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .title {
    font-size: 14px;
    line-height: 1.25rem;
    font-weight: 600;
    color: red;
  }
</style>
