{
  "name": "@pulsar/docs",
  "type": "module",
  "version": "0.0.1",
  "description": "A Pulsar theme for documentation site",
  "author": "Ernest Nkansah-Badu <ernestjbadu@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/Ernxst/pulsar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ernxst/pulsar.git",
    "directory": "packages/theme-docs"
  },
  "bugs": {
    "url": "https://github.com/Ernxst/pulsar/issues"
  },
  "keywords": [
    "astro",
    "docs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./components": {
      "types": "./src/components/index.d.ts",
      "import": "./src/components/index.js"
    },
    "./components/*.astro": {
      "types": "./src/components/*.astro",
      "import": "./src/components/*.astro"
    },
    "./layouts": {
      "types": "./src/layouts/index.d.ts",
      "import": "./src/layouts/index.js"
    },
    "./layouts/*.astro": {
      "types": "./src/layouts/*.astro",
      "import": "./src/layouts/*.astro"
    },
    "./package.json": "./src/package.json"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./src/index.d.ts"
      ],
      "components": [
        "./src/components/index.d.ts"
      ],
      "layouts": [
        "./src/layouts/index.d.ts"
      ],
      "components/*.astro": [
        ".src/components/*.astro"
      ],
      "layouts/*.astro": [
        "./src/layouts/*.astro"
      ]
    }
  },
  "files": [
    ".",
    "README.md"
  ],
  "engines": {
    "node": ">=v14.16.0",
    "pnpm": ">=8.2.0"
  },
  "scripts": {
    "-------------------------------------------------------------------------------": "",
    "lint:pkg": "publint",
    "--------------------------------------------------------------------------------": "",
    "typecheck": "tsc --noEmit",
    "---------------------------------------------------------------------------------": "",
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": "^2.4.0",
    "pulsar": "^0.0.1"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": false
    },
    "pulsar": {
      "optional": false
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.6.0",
    "inflection": "^2.0.1",
    "zod": "3.21.4"
  },
  "devDependencies": {
    "@pulsar/tsconfig": "workspace:*",
    "@vitest/coverage-istanbul": "0.31.0",
    "publint": "0.1.11",
    "typescript": "5.0.4",
    "vitest": "0.31.0"
  }
}
